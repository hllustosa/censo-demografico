# DEVELOPMENT ONLY — DO NOT USE THESE VALUES IN PRODUCTION
# Copy to .env: `make env` or `cp .env.example .env`

# MongoDB local demo uses an unauthenticated single-node replica set
# so transactional outbox works without keyFile complexity.
# Production should enable auth + keyFile / TLS.

# Neo4j (password must be at least 8 characters on Neo4j 5.x)
NEO4J_AUTH=neo4j/testtest
NEO4J_PASSWORD=testtest

# RabbitMQ
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest

# JWT — required; must be at least 32 characters. Services refuse to start without it.
JWT_SIGNING_KEY=CensusDevSigningKeyMustBeAtLeast32CharsLong!
JWT__Issuer=census-identity
JWT__Audience=census-api

# Identity admin bootstrap (DEVELOPMENT ONLY)
Identity__Admin__Email=admin@censo.local
Identity__Admin__Password=Admin@12345

# Grafana (observability profile)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Set automatically by `make observability` — leave empty for normal `make up`
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
