# MongoDB
MONGO_INITDB_ROOT_USERNAME=guest
MONGO_INITDB_ROOT_PASSWORD=guest

# Neo4j
NEO4J_AUTH=neo4j/test

# RabbitMQ
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest

# JWT (shared across all API services)
JWT_SIGNING_KEY=CensusDevSigningKeyMustBeAtLeast32CharsLong!
JWT__SigningKey=${JWT_SIGNING_KEY}
JWT__Issuer=census-identity
JWT__Audience=census-api

# Identity Service
ConnectionStrings__Identity=mongodb://guest:guest@mongo:27017/identitydb?authSource=admin
Identity__Admin__Email=admin@censo.local
Identity__Admin__Password=Admin@12345

# People Service
ConnectionStrings__DefaultConnection=mongodb://guest:guest@mongo:27017/?authSource=admin
RabbitMqConnection__HostName=rabbitmq
RabbitMqConnection__Username=guest
RabbitMqConnection__Password=guest
RabbitMqConnection__PublisherOnly=true
RabbitMqConnection__retryCount=5

# Statistics Service
# ConnectionStrings__DefaultConnection (same as above)
RabbitMqConnection__QueueName=statistics

# FamilyTree Service
Neo4j__Uri=http://neo4j:7474/db/data
Neo4j__Username=neo4j
Neo4j__Password=test
RabbitMqConnection__QueueName=tree
